# 4.  HYPERBOLIC EMBEDDING
# ══════════════════════════════════════════════════════════════════════

class HyperbolicEmbedding(nn.Module):
    def __init__(self, vocab_size: int, d_model: int, curvature: float = 1.0):
        super().__init__()
        self.c = curvature
        self.embed = nn.Embedding(vocab_size, d_model)
        nn.init.normal_(self.embed.weight, 0, 0.01)
        # CIF: max_norm is static — compute once
        self._max_norm_cif = CIFScalar(lambda: (1 - 1e-3) / math.sqrt(curvature))

    def forward(self, ids: torch.Tensor) -> torch.Tensor:
        x = self.embed(ids)
        norm    = x.norm(dim=-1, keepdim=True)
        max_n   = self._max_norm_cif.get()   # O(1) after first call
        return x / (torch.clamp(norm / max_n, max=1.0) + 1e-8)


