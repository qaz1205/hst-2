def run_tests():
    print("\n" + "═"*62)
    print("  Io v1.0 — Self-Test + CIF Benchmark")
    print("═"*62)

    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    # ── CIF benchmark ──────────────────────────────────────────────
    print("\n[CIF] Benchmarking Deny vs plain if vs Affirm (10,000 iters)...")
    N = 10000
    def expensive(x): _ = sum(range(1000)); return x > 0

    t0 = time.time()
    for _ in range(N): expensive(5)
    t_plain = time.time() - t0

    t0 = time.time()
    a = Affirm(5)
    for _ in range(N): a.test(expensive)
    t_affirm = time.time() - t0

    t0 = time.time()
    d = Deny(5)
    for _ in range(N): d.test(expensive)
    t_deny = time.time() - t0

    print(f"  plain if : {t_plain*1000:.1f}ms")
    print(f"  Affirm   : {t_affirm*1000:.1f}ms")
    print(f"  Deny     : {t_deny*1000:.1f}ms  ← {t_plain/max(t_deny,1e-9):.0f}x faster")

    # ── CIFScalar benchmark ────────────────────────────────────────
    print("\n[CIFScalar] Static constant access (1M iters)...")
    cs = CIFScalar(lambda: 1.0 / math.sqrt(64))
    t0 = time.time()
    for _ in range(1_000_000): cs.get()
    t_cs = time.time() - t0
    t0 = time.time()
    for _ in range(1_000_000): 1.0 / math.sqrt(64)
    t_raw = time.time() - t0
    print(f"  raw compute: {t_raw*1000:.1f}ms")
    print(f"  CIFScalar  : {t_cs*1000:.1f}ms  ← {t_raw/max(t_cs,1e-9):.1f}x faster")

    # ── CIFRegistry ────────────────────────────────────────────────
    print("\n[CIFRegistry] All static model scalars resolved...")
    cfg = IoConfig(vocab_size=1000, d_model=128, n_heads=4,
                   n_layers=4, max_seq_len=256, max_horizon=16, fb_iterations=1)
    reg = CIFRegistry(cfg)
    print(f"  attn_scale : {reg.attn_scale.get():.6f}")
    print(f"  head_dim   : {reg.head_dim.get()}")
    print(f"  log_vocab  : {reg.log_vocab.get():.4f}")
    print(f"  hebb_decay : {reg.hebb_decay.get()}")
    print(f"  top_k_cap  : {reg.top_k_cap.get()}")
    print(f"  lm_weight  : {reg.lm_weight.get()}")
    print(f"  hor_weight : {reg.hor_weight.get()}")

    # ── Model ──────────────────────────────────────────────────────
    print("\n[Model] Building Io...")
    model = Io(cfg).to(dev)
    n = sum(p.numel() for p in model.parameters())
    print(f"  Parameters : {n:,}")

    print("\n[Forward] Pass...")
    ids = torch.randint(0, 1000, (2, 64)).to(dev)
    out = model(ids, training=True)
    print(f"  logits         : {out['logits'].shape}")
    print(f"  horizon_logits : {out['horizon_logits'].shape}")
    print(f"  uncertainty    : {out['uncertainty'].shape}")
    print(f"  early-exit depth: {out['depth']}")

    print("\n[Backward] Gradients...")
    loss = out["logits"].mean() + out["horizon_logits"].mean()
    loss.backward()
    g = sum(1 for p in model.parameters() if p.grad is not None)
    t = sum(1 for _ in model.parameters())
    print(f"  {g}/{t} parameters have gradients ✓")

    print("\n[Generate] Speculative decoding...")
    prompt = torch.randint(0, 100, (1, 8)).to(dev)
    with torch.no_grad():
        gen, stats = model.generate(prompt, max_new=20, top_k=10)
    print(f"  Generated : {stats['tokens']} tokens")
    print(f"  Accept rate: {stats['accept_rate']:.2f}")
    print(f"  Speedup   : {stats['speedup']:.1f}x")

    print("\n" + "═"*62)
    print("  ALL TESTS PASSED ✓")
    print("═"*62 + "\n")


