# 12.  IO MODEL
# ══════════════════════════════════════════════════════════════════════

class Io(nn.Module):
    def __init__(self, cfg: IoConfig):
        super().__init__()
        self.cfg = cfg
        D, H     = cfg.d_model, cfg.n_heads
        n_bot    = cfg.n_layers // 2
        n_top    = cfg.n_layers - n_bot

        # ── CIF Registry: built ONCE, shared across ALL submodules ──
        # Every static scalar in the model resolves from here in O(1)
        self.cif = CIFRegistry(cfg)

        # Spine
        self.analyzer = SpineAnalyzer(cfg.max_seq_len)

        # Input
        self.token_embed = HyperbolicEmbedding(cfg.vocab_size, D)
        self.pos_enc     = LatticePositionalEncoding(D, cfg.max_seq_len, self.cif)
        self.in_drop     = nn.Dropout(cfg.dropout)

        # Lattice
        self.lattice     = CompleteLatticeCore(D, self.analyzer, self.cif)

        # Adaptive bottom
        self.bot_blocks  = nn.ModuleList(
            [AdaptiveBlock(D, H, self.cif) for _ in range(n_bot)])

        # Top stack
        self.top_blocks  = nn.ModuleList(
            [TransformerLayer(D, H, self.cif, cfg.dropout) for _ in range(n_top)])

        # Self-correction
        self.feedback    = FeedbackLoop(D, self.cif)

        # Inference plasticity
        self.hebbian     = HebbianFastWeights(D, self.cif)

        # Output
        self.out_norm    = nn.LayerNorm(D)
        self.lm_head     = nn.Linear(D, cfg.vocab_size, bias=False)

        # Horizon predictor
        self.horizon     = UncertaintyAwareHorizon(
            D, cfg.vocab_size, cfg.max_horizon, self.cif)

        # CIF: log(vocab_size) for entropy normalisation — static
        self._log_vs_cif = self.cif.log_vocab   # CIFScalar, O(1) on .get()

        self._init_weights()

    def _init_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.normal_(m.weight, 0, 0.005)
                if m.bias is not None: nn.init.zeros_(m.bias)
            elif isinstance(m, nn.Embedding):
                nn.init.normal_(m.weight, 0, 0.005)

    def forward(self, ids: torch.Tensor,
                cache: KVCache = None,
                training: bool = True) -> Dict[str, torch.Tensor]:
        B, S  = ids.shape
        dev   = ids.device
        past_len = cache[0][0].size(2) if cache else 0

        positions = torch.arange(past_len, past_len+S, device=dev).unsqueeze(0).expand(B,-1)
        x = self.token_embed(ids) + self.pos_enc(positions)
        x = self.in_drop(x)
        x = x + self.lattice(x)

        new_cache = []; ci = 0; depth = len(self.bot_blocks)
        for i, blk in enumerate(self.bot_blocks):
            lp = cache[ci] if cache else None
            x, conf, pres, should_exit = blk(x, lp)
            new_cache.append(pres); ci += 1
            # CIF: should_exit uses Deny threshold internally
            if not training and past_len == 0 and i >= 1 and should_exit:
                depth = i + 1; break

        for blk in self.top_blocks:
            lp = cache[ci] if cache else None
            x, pres = blk(x, lp)
            new_cache.append(pres); ci += 1

        x = self.feedback(x)
        if not training:
            x = self.hebbian(x)

        h    = self.out_norm(x)
        lgts = self.lm_head(h)
        hor_lgts, hor_len, unc = self.horizon(h)

        # Entropy — CIF: log(vocab_size) is static
        probs   = lgts.softmax(-1)
        log_vs  = self._log_vs_cif.get()   # O(1), no recompute
        entropy = -(probs * (probs + 1e-10).log()).sum(-1) / log_vs

        return {"logits": lgts, "horizon_logits": hor_lgts, "horizon_len": hor_len,
                "uncertainty": entropy, "hidden": h, "cache": new_cache, "depth": depth}

    # ── GENERATION ──────────────────────────────────────────────────

    @torch.no_grad()
    def generate(self, prompt_ids: torch.Tensor,
                 max_new: int = 200,
                 temperature: float = 0.8,
                 top_k: int = 50,
                 top_p: float = 0.9) -> Tuple[torch.Tensor, dict]:
        self.eval()
        ids   = prompt_ids.clone()
        cache = None
        generated = 0; accepted = 0

        out   = self(ids, training=False)
        cache = out["cache"]

        # CIF: top_k cap is static per generate call — cache it
        _tkc  = CIFScalar(lambda: min(top_k, self.cfg.vocab_size))
        tkc   = _tkc.get()   # O(1) every token after first

        for _ in range(max_new):
            if generated >= max_new: break

            last_l = out["logits"][:, -1, :] / temperature
            last_l = _top_kp(last_l, tkc, top_p)   # CIF cap applied
            t0     = torch.multinomial(last_l.softmax(-1), 1)

            H = min(out["horizon_len"][0].item(), max_new - generated)

            # CIF: draft loop count H is dynamic (Affirm) — don't cache
            hor_lgts = out["horizon_logits"]
            drafts   = [t0.squeeze(-1)]
            for k in range(1, H):
                lk = hor_lgts[:, k, :] / temperature
                lk = _top_kp(lk, tkc, top_p)   # CIF: tkc O(1)
                drafts.append(torch.multinomial(lk.softmax(-1), 1).squeeze(-1))
            draft_ids = torch.stack(drafts, dim=1)

            ver_out  = self(draft_ids, cache=cache, training=False)
            ver_lgts = ver_out["logits"][0]

            n_acc = 0
            for k in range(draft_ids.size(1)):
                vp = ver_lgts[k].softmax(-1)
                dt = draft_ids[0, k].item()
                if (vp[dt] / vp.max()) >= torch.rand(1, device=ids.device):
                    n_acc += 1
                else:
                    lk = ver_lgts[k] / temperature
                    new_t = torch.multinomial(_top_kp(lk, tkc, top_p).softmax(-1), 1)
                    draft_ids[0, k] = new_t.squeeze()
                    break

            accepted_ids = draft_ids[:, :n_acc+1]
            ids        = torch.cat([ids, accepted_ids], dim=1)
            generated += accepted_ids.size(1)
            accepted  += n_acc
            cache      = ver_out["cache"]
            out        = ver_out

            if ids[0,-1].item() == self.cfg.vocab_size - 1: break

        rate = accepted / max(generated, 1)
        return ids, {"tokens": generated, "accept_rate": rate,
                     "speedup": 1 + rate * (self.cfg.max_horizon - 1)}


# ══════════════════════════════════════════════════════════════════════
# 13.  SAMPLING UTILS
# ══════════════════════════════════════════════════════════════════════

def _top_kp(logits: torch.Tensor, top_k: int, top_p: float) -> torch.Tensor:
    if top_k > 0:
        v, _ = torch.topk(logits, top_k)
        logits.masked_fill_(logits < v[..., -1:], float("-inf"))
    if top_p < 1.0:
        sl, si = torch.sort(logits, descending=True)
        cum = sl.softmax(-1).cumsum(-1)
        rem = cum > top_p
        rem[..., 1:] = rem[..., :-1].clone(); rem[..., 0] = False
        
        # FIX: Scatter the sorted mask back to the original logit positions
        rem_orig = torch.zeros_like(rem).scatter_(-1, si, rem)
        logits.masked_fill_(rem_orig, float("-inf"))
        
    return logits


