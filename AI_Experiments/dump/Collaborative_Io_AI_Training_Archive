# 6.  DIAMOND MIXER
# ══════════════════════════════════════════════════════════════════════

class DiamondMixer(nn.Module):
    def __init__(self, d_model: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif   = cif
        self.split  = nn.Linear(d_model, d_model * 2)
        self.merge  = nn.Linear(d_model * 2, d_model)
        self.norm   = nn.LayerNorm(d_model)
        # CIF: split output size is static
        self._split_sz = cif.diamond_split.get()   # d_model * 2, O(1)

    def forward(self, u: torch.Tensor) -> torch.Tensor:
        xy = self.split(u)
        # chunk size = d_model — CIF: static, same every call
        x, y = xy.chunk(2, dim=-1)
        out = self.merge(torch.cat([F.gelu(x+y), F.gelu(y-x)], dim=-1))
        return self.norm(u + out)


