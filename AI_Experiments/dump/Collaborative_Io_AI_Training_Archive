# 3.  LATTICE POSITIONAL ENCODING
# ══════════════════════════════════════════════════════════════════════

class LatticePositionalEncoding(nn.Module):
    def __init__(self, d_model: int, max_seq_len: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif = cif
        half = d_model // 2
        pe = torch.zeros(max_seq_len, half)
        pos = torch.arange(max_seq_len).unsqueeze(1).float()
        div = torch.exp(torch.arange(0, half, 2).float() * -(math.log(10000) / half))
        pe[:, 0::2] = torch.sin(pos * div)
        pe[:, 1::2] = torch.cos(pos * div)
        self.register_buffer("abs_pe", pe)
        self.lattice_enc = nn.Sequential(
            nn.Linear(3, half), nn.LayerNorm(half), nn.GELU())
        self.spine = build_spine(max_seq_len)
        # CIF: spine tensor is static — compute once
        self._spine_cif = CIFScalar(lambda: None)  # triggers on first forward
        self._spine_tensor = None

    def forward(self, positions: torch.Tensor) -> torch.Tensor:
        B, S = positions.shape
        abs_part = self.abs_pe[positions]
        # CIF: build spine tensor once, reuse — Deny the rebuild check
        if self._spine_tensor is None or self._spine_tensor.device != positions.device:
            self._spine_tensor = torch.tensor(
                self.spine, dtype=torch.float32, device=positions.device)
        sp = self._spine_tensor
        feats = []
        for b in range(B):
            row = []
            for p in positions[b]:
                pf = p.float()
                left  = sp[sp <= pf]; right = sp[sp > pf]
                ld = (pf - left[-1])  if len(left)  > 0 else pf.new_zeros(1)
                rd = (right[0] - pf) if len(right) > 0 else pf.new_zeros(1)
                lv = torch.tensor(float(len(left)), device=p.device)
                row.append(torch.stack([ld.squeeze(), rd.squeeze(), lv]))
            feats.append(torch.stack(row))
        lat = self.lattice_enc(torch.stack(feats).to(positions.device))
        return torch.cat([abs_part, lat], dim=-1)


