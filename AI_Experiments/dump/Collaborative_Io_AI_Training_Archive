def chat(cfg: IoConfig, checkpoint: str):
    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    try:
        import tiktoken
        enc = tiktoken.get_encoding("gpt2"); cfg.vocab_size = enc.n_vocab
        encode = enc.encode; decode = enc.decode
    except ImportError:
        encode = lambda t: [ord(c) for c in t]
        decode = lambda t: "".join(chr(i) for i in t)
        cfg.vocab_size = 65536

    model = Io(cfg).to(dev)
    if os.path.exists(checkpoint):
        model.load_state_dict(torch.load(checkpoint, map_location=dev))
        print(f"[Io] Loaded {checkpoint}")
    else:
        print("[Io] No checkpoint — untrained (test only)")
    model.eval()

    print("\n╔══════════════════════════╗")
    print("║    Io v1.0  —  Chat      ║")
    print("║  'quit' to exit          ║")
    print("╚══════════════════════════╝\n")

    while True:
        try: prompt = input("You: ").strip()
        except (EOFError, KeyboardInterrupt): print("\n[Io] Bye."); break
        if prompt.lower() in ("quit","exit","q"): break
        if not prompt: continue
        ids = torch.tensor([encode(prompt)], dtype=torch.long, device=dev)
        with torch.no_grad():
            out_ids, stats = model.generate(ids, max_new=200,
                temperature=cfg.temperature, top_k=cfg.top_k, top_p=cfg.top_p)
        print(f"Io: {decode(out_ids[0, ids.size(1):].tolist())}")
        print(f"    [tokens={stats['tokens']}  accept={stats['accept_rate']:.2f}"
              f"  speedup={stats['speedup']:.1f}x]\n")


