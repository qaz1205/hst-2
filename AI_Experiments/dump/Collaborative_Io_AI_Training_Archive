# 14.  TRAINING PIPELINE
# ══════════════════════════════════════════════════════════════════════

class CurriculumScheduler:
    """
    Logarithmic horizon: 4 → max_horizon.
    CIF: horizon value is re-cached each step via CIFRegistry.cur_horizon.
    During stable phases (many steps at same horizon), Deny makes the
    `get_horizon()` call O(1) — no re-computation.
    """
    def __init__(self, cfg: IoConfig, cif: CIFRegistry):
        self._max_h    = cfg.max_horizon
        self._warmup   = cfg.curriculum_warmup
        self._step     = 0
        self._cif      = cif
        self._last_h   = -1
        # Deny: horizon won't change for many steps — cache it
        self._h_state  = Deny(self._step)

    def horizon(self) -> int:
        p = min(self._step / self._warmup, 1.0)
        h = min(int(4 * (self._max_h / 4) ** p), self._max_h)
        if h != self._last_h:
            # Horizon changed: flip to Affirm (re-compute next call)
            self._last_h = h
            self._cif.cur_horizon = CIFScalar(lambda: h)
        return self._cif.cur_horizon.get()   # O(1) when stable

    def tick(self): self._step += 1


def compute_loss(out: dict, targets: torch.Tensor,
                 cif: CIFRegistry, cur_horizon: int) -> torch.Tensor:
    B, S, V = out["logits"].shape

    # CIF: loss weights are static constants — O(1) each
    lm_w  = cif.lm_weight.get()
    hor_w = cif.hor_weight.get()
    unc_w = cif.unc_weight.get()

    lm = F.cross_entropy(out["logits"][:,:-1,:].reshape(-1,V),
                         targets[:,1:].reshape(-1), ignore_index=-1)
    h_loss = lm.new_tensor(0.0)
    if cur_horizon > 1:
        H = min(cur_horizon, out["horizon_logits"].size(1), S-1)
        for k in range(H):
            tgt_k = targets[:, k+1:k+2].reshape(-1)
            valid = tgt_k != -1
            if valid.any():
                h_loss = h_loss + F.cross_entropy(
                    out["horizon_logits"][:,k,:][valid], tgt_k[valid])
        h_loss = h_loss / H

    unc_reg = out["uncertainty"].mean()
    return lm_w * lm + hor_w * h_loss + unc_w * unc_reg


def train(cfg: IoConfig, data_path: str, checkpoint: Optional[str] = None):
    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[Io] Device: {dev}")

    try:
        import tiktoken
        enc = tiktoken.get_encoding("gpt2"); cfg.vocab_size = enc.n_vocab
        encode = lambda t: enc.encode(t, allowed_special="all")
        decode = enc.decode
        print("[Io] tiktoken GPT-2 tokenizer")
    except ImportError:
        print("[Io] char-level fallback")
        encode = lambda t:[ord(c) for c in t]
        decode = lambda t: "".join(chr(i) for i in t)
        cfg.vocab_size = 65536

    if not os.path.exists(data_path):
        print(f"[Io] {data_path} not found — using random data")
        train_data = torch.randint(0, cfg.vocab_size, (10000,))
    else:
        raw = open(data_path, encoding="utf-8").read()
        train_data = torch.tensor(encode(raw), dtype=torch.long)
        print(f"[Io] {len(train_data):,} tokens  vocab={cfg.vocab_size}")

    model = Io(cfg).to(dev)
    print(f"[Io] Parameters: {sum(p.numel() for p in model.parameters()):,}")

    if checkpoint and os.path.exists(checkpoint):
        model.load_state_dict(torch.load(checkpoint, map_location=dev))
        print(f"[Io] Loaded: {checkpoint}")

    opt   = torch.optim.AdamW(model.parameters(), lr=cfg.lr,
                               weight_decay=cfg.weight_decay, betas=(0.9,0.95))
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, cfg.max_steps)
    cur   = CurriculumScheduler(cfg, model.cif)   # shares the CIF registry
    best  = float("inf"); t0 = time.time()

    for step in range(1, cfg.max_steps+1):
        model.train()
        ix = torch.randint(len(train_data)-cfg.max_seq_len-1, (cfg.batch_size,))
        x  = torch.stack([train_data[i:i+cfg.max_seq_len]   for i in ix]).to(dev)
        y  = torch.stack([train_data[i+1:i+cfg.max_seq_len+1] for i in ix]).to(dev)

        # Tweak: Accumulate 8 steps to simulate Batch Size 16
        accum_steps = 8 
        
        out  = model(x, training=True)
        loss = compute_loss(out, y, model.cif, cur.horizon())
        
        # Scale loss by accumulation steps
        (loss / accum_steps).backward()

        if step % accum_steps == 0:
            nn.utils.clip_grad_norm_(model.parameters(), cfg.grad_clip)
            opt.step()
            sched.step()
            opt.zero_grad()
            
        cur.tick()

        if step <= cfg.warmup_steps:
            for pg in opt.param_groups:
                pg["lr"] = cfg.lr * step / cfg.warmup_steps

        if step % 100 == 0:
            print(f"[Io] step={step:6d}  loss={loss.item():.4f}  "
                  f"horizon={cur.horizon():2d}  "
                  f"lr={opt.param_groups[0]['lr']:.2e}  "
                  f"t={time.time()-t0:.0f}s"); t0=time.time()

        if step % 1000 == 0 and loss.item() < best:
            best = loss.item()
            torch.save(model.state_dict(), "io_checkpoint.pt")
            print(f"[Io] ✓ Checkpoint saved (loss={best:.4f})")

    print("[Io] Training complete.")


