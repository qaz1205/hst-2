# 8.  HEBBIAN FAST WEIGHTS
# ══════════════════════════════════════════════════════════════════════

class HebbianFastWeights(nn.Module):
    def __init__(self, d_model: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif  = cif
        self.qkv   = nn.Linear(d_model, d_model * 3, bias=False)
        self.norm  = nn.LayerNorm(d_model)
        # CIF: decay is a static constant — Deny it
        # Every call: O(1) lookup instead of attribute access + float op
        self._decay_cif = Deny(cif.hebb_decay.get())

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        B, S, D = x.shape
        qkv = self.qkv(x).reshape(B, S, 3, D).permute(2,0,1,3)
        q, k, v = qkv[0], qkv[1], qkv[2]
        kv  = torch.einsum("bsd,bse->bde", k, v)
        # CIF: decay — Deny path, O(1), monomorphic branch
        dec = self._cif.hebb_decay.get()
        kv  = kv * dec
        out = torch.einsum("bsd,bde->bse", q, kv)
        lr  = torch.sigmoid((q * k).sum(-1, keepdim=True))
        return self.norm(x + out * lr)


