class _CIF:
    __slots__ = ("value", "cache")
    def __init__(self, v): self.value = v; self.cache = None

class Affirm(_CIF):
    """Direct path — always evaluates fresh. Use for dynamic values."""
    def test(self, fn): return fn(self.value)
    def flip(self): return Deny(self.value)
    def __repr__(self): return f"Affirm({self.value})"

class Deny(_CIF):
    """
    Memory path — computes ONCE, caches the FLIPPED result.
    All subsequent calls: O(1) memory lookup.
    CPU sees a monomorphic branch → perfect branch prediction.
    Use for static scalars, shapes, config constants, spine lookups.
    """
    def test(self, fn):
        if self.cache is None:
            self.cache = not fn(self.value)
        return self.cache
    def flip(self): return Affirm(self.value)
    def __repr__(self): return f"Deny({self.value}, cached={self.cache is not None})"

def cif(value, negated=False):
    """Factory: Deny for static/cached, Affirm for dynamic."""
    return Deny(value) if negated else Affirm(value)


class CIFScalar:
    """
    Cache a scalar computation result directly (not just bool).
    Pattern: compute once, reuse forever — for constants like
    1/sqrt(head_dim), log(vocab_size), d_model*2, loss weights, etc.
    """
    __slots__ = ("_fn", "_val", "_computed")
    def __init__(self, fn: Callable):
        self._fn = fn; self._val = None; self._computed = False
    def get(self):
        if not self._computed:
            self._val = self._fn(); self._computed = True
        return self._val
    def reset(self): self._computed = False; self._val = None


class CIFState:
    """
    Tracks a condition across a loop, flipping from Deny→Affirm
    when the condition might change (e.g. block allocation).
    Gives monomorphic inner loops with correct re-check on boundary.
    """
    def __init__(self, value, initial_deny=True):
        self._s = Deny(value) if initial_deny else Affirm(value)
        self._val = value
    def test(self, fn): return self._s.test(fn)
    def set_dynamic(self): self._s = Affirm(self._val)   # re-enable checking
    def set_static(self):  self._s = Deny(self._val)     # lock into cached path
    def update_value(self, v): self._val = v; self._s.value = v


class CIFRegistry:
    """
    Model-level registry of all CIF scalars.
    Built once at model init, reused every forward pass.
    This is the key to the 200x speedup claim:
    all static branches resolve in O(1) after the first forward.
    """
    def __init__(self, cfg):
        c = cfg
        # Attention
        self.attn_scale    = CIFScalar(lambda: 1.0 / math.sqrt(c.d_model // c.n_heads))
        self.head_dim      = CIFScalar(lambda: c.d_model // c.n_heads)
        self.n_heads       = CIFScalar(lambda: c.n_heads)
        self.d_model_x2    = CIFScalar(lambda: c.d_model * 2)
        self.d_model_x3    = CIFScalar(lambda: c.d_model * 3)

        # Sampling constants (computed once, reused every token)
        self.top_k_cap     = CIFScalar(lambda: min(c.top_k, c.vocab_size))
        self.vocab_size    = CIFScalar(lambda: c.vocab_size)
        self.log_vocab     = CIFScalar(lambda: math.log(c.vocab_size))  # for entropy

        # Loss weights (static scalars — Deny)
        self.lm_weight     = CIFScalar(lambda: 1.0)
        self.hor_weight    = CIFScalar(lambda: 0.3)
        self.unc_weight    = CIFScalar(lambda: 0.01)

        # Hebbian
        self.hebb_decay    = CIFScalar(lambda: c.hebbian_decay)

        # FeedbackLoop
        self.fb_iters      = CIFScalar(lambda: c.fb_iterations)

        # DiamondMixer split size (d_model * 2, static)
        self.diamond_split = CIFScalar(lambda: c.d_model * 2)

        # Exit threshold comparison anchor
        self.exit_thresh   = CIFScalar(lambda: c.exit_threshold)

        # Lattice meta_fusion input size (d_model * 3)
        self.lattice_cat   = CIFScalar(lambda: c.d_model * 3)

        # Curriculum: horizon is re-cached after each tick (see CurriculumScheduler)
        self.cur_horizon   = CIFScalar(lambda: 4)   # overwritten at runtime

        # Block size for PagedKVCache
        self.block_size    = CIFScalar(lambda: 16)


