# 5.  FLASH BLOCK-SPARSE ATTENTION  w/  PAGED KV CACHE
# ══════════════════════════════════════════════════════════════════════

KVCache = Optional[List[Tuple[torch.Tensor, torch.Tensor]]]


class PagedKVCache:
    """
    CIF allocation pattern:
    - Inner write loop: Deny ("do I need a new block?") → monomorphic fast path
    - After filling a block: flip to Affirm for one check, then back to Deny
    This makes the inner loop branch-predictor-friendly.
    """
    def __init__(self, head_dim, n_heads, cif: 'CIFRegistry', device="cpu"):
        self.hd, self.nh, self.dev = head_dim, n_heads, device
        self.bs = cif.block_size.get()        # CIF: static block size
        self.k_blocks: List[torch.Tensor] = []
        self.v_blocks: List[torch.Tensor] = []
        self.length = 0
        self._alloc = CIFState(self, initial_deny=False)  # start Affirm (need first block)

    def append(self, k: torch.Tensor, v: torch.Tensor):
        if k.dim() == 4: k, v = k.squeeze(0), v.squeeze(0)
        seq = k.size(0); written = 0
        while written < seq:
            # CIF: need new block? — Deny (cached) in inner loop, Affirm only at boundary
            need = self._alloc.test(
                lambda s: not s.k_blocks or s.k_blocks[-1].size(0) >= s.bs)
            if need:
                self.k_blocks.append(torch.empty(0, self.nh, self.hd, device=self.dev))
                self.v_blocks.append(torch.empty(0, self.nh, self.hd, device=self.dev))
                self._alloc.set_static()   # inner iterations: Deny (no new block needed)
            space = self.bs - self.k_blocks[-1].size(0)
            n = min(space, seq - written)
            kc, vc = k[written:written+n], v[written:written+n]
            kb = self.k_blocks[-1]
            self.k_blocks[-1] = kc if kb.numel()==0 else torch.cat([kb, kc])
            vb = self.v_blocks[-1]
            self.v_blocks[-1] = vc if vb.numel()==0 else torch.cat([vb, vc])
            written += n
            if self.k_blocks[-1].size(0) >= self.bs:
                self._alloc.set_dynamic()  # block full: next check needs to allocate
        self.length += seq

    def get_all(self):
        if not self.k_blocks: return None, None
        return (torch.cat(self.k_blocks).unsqueeze(0),
                torch.cat(self.v_blocks).unsqueeze(0))


class FlashBlockSparseAttention(nn.Module):
    def __init__(self, d_model: int, n_heads: int, cif: 'CIFRegistry', dropout: float = 0.1):
        super().__init__()
        self._cif  = cif
        self.nh    = n_heads
        # CIF: head_dim and scale are static — compute once
        self._hd   = cif.head_dim.get()
        self._sc   = cif.attn_scale.get()    # 1/sqrt(head_dim) — never changes
        self.qkv   = nn.Linear(d_model, d_model * 3, bias=False)
        self.proj  = nn.Linear(d_model, d_model, bias=False)
        self.drop  = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor,
                layer_past: Optional[Tuple] = None) -> Tuple[torch.Tensor, Tuple]:
        B, S, D = x.shape
        hd = self._hd   # CIF: O(1) static scalar
        nh = self.nh
        qkv = self.qkv(x).reshape(B, S, 3, nh, hd)
        q, k, v = qkv.permute(2, 0, 3, 1, 4)

        if layer_past is not None:
            pk, pv = layer_past
            k = torch.cat([pk, k], dim=2)
            v = torch.cat([pv, v], dim=2)
        present = (k, v)

        if hasattr(F, "scaled_dot_product_attention"):
            out = F.scaled_dot_product_attention(
                q, k, v,
                dropout_p=self.drop.p if self.training else 0.0,
                is_causal=(layer_past is None))
        else:
            sc = (q @ k.transpose(-2,-1)) * self._sc  # CIF scalar — no recompute
            if layer_past is None:
                mask = torch.triu(torch.ones(S, k.size(2), device=x.device), diagonal=1).bool()
                sc.masked_fill_(mask, float("-inf"))
            out = self.drop(sc.softmax(-1)) @ v

        out = out.transpose(1,2).reshape(B, S, D)
        return self.proj(out), present


