# 2.  PELL-LUCAS SPINE
# ══════════════════════════════════════════════════════════════════════

def build_spine(max_len: int) -> List[int]:
    s = [0, 2, 4]
    while True:
        nxt = 2 * s[-1] + s[-2]
        if nxt >= max_len: break
        s.append(nxt)
    return s


class SpineAnalyzer:
    """
    Pre-computes BFS ancestor trees for all spine positions.
    CIF used for:
    - Repeated `get(pos)` calls: Deny caches "have I seen this pos?" check
    - Ancestor list lookups: Deny caches spine-index lookup per position
    - Path-count DP: Affirm for dynamic accumulation, Deny for static max_depth
    """
    def __init__(self, max_seq_len: int):
        self.spine   = build_spine(max_seq_len)
        self._spine_idx = {v: i for i, v in enumerate(self.spine)}
        self._structs: Dict[int, dict] = {}
        self._non_spine: Dict[int, dict] = {}

        # CIF: "is this a precomputed spine node?" — static after init
        # Deny because most repeated calls will be for spine nodes (cache hit)
        self._is_spine   = {pos: Deny(pos) for pos in self.spine}

        # CIF: ancestor lists per position — static, compute once
        self._anc_cache  = {}

        for pos in self.spine:
            self._structs[pos] = self._analyze(pos)

    def _ancestors(self, pos: int) -> List[int]:
        # CIF: same position queried many times — cache with Deny
        if pos not in self._anc_cache:
            state = Deny(pos)
            def _compute(p):
                if p in self._spine_idx:
                    i = self._spine_idx[p]
                    if i >= 3:
                        return [self.spine[i-1], self.spine[i-2], self.spine[i-3]]
                return []
            # Force compute and store
            result = _compute(pos)
            # Store as Deny: subsequent calls return cached (flipped bool irrelevant —
            # we store the actual list separately)
            self._anc_cache[pos] = result
            state.test(lambda p: True)   # prime the cache
        return self._anc_cache[pos]

    def _analyze(self, pos: int) -> dict:
        levels = {0: [pos]}; visited = {pos}; current = [pos]; lvl = 0
        while current and lvl < 10:
            nxt = set()
            for node in current:
                for anc in self._ancestors(node):
                    if anc not in visited and anc >= 0:
                        visited.add(anc); nxt.add(anc)
            current = list(nxt); lvl += 1
            if current: levels[lvl] = list(current)

        max_depth = max(levels) if levels else 0
        # CIF: max_depth is static per position — Deny for the depth check in DP
        _max_depth_cif = Deny(max_depth)

        pc = {pos: 1}
        for lv in sorted(levels, reverse=True):
            for node in levels[lv]:
                if node == pos: continue
                # Use Deny to cache "is this the max depth?" per node
                is_max = _max_depth_cif.test(lambda d: lv == d)
                if is_max: pc[node] = 1; continue
                count = sum(pc.get(child, 0)
                            for child in levels.get(lv+1, [])
                            if node in self._ancestors(child))
                if lv != 0: pc[node] = count
        pc.pop(pos, None)
        return {"levels": levels, "path_counts": pc,
                "total_ancestors": len(visited)-1, "max_depth": max_depth}

    def get(self, pos: int) -> dict:
        if pos in self._structs: return self._structs[pos]
        if pos not in self._non_spine:
            left = [s for s in self.spine if s < pos]
            ancs = [left[-1]] if left else []
            self._non_spine[pos] = {"levels": {0:[pos],1:ancs},
                                    "path_counts": {a:1 for a in ancs},
                                    "total_ancestors": len(ancs), "max_depth": 1}
        return self._non_spine[pos]


