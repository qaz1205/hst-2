# 9.  COMPLETE LATTICE CORE
# ══════════════════════════════════════════════════════════════════════

class MultiLevelLatticeProcessor(nn.Module):
    def __init__(self, d_model: int, analyzer: SpineAnalyzer, cif: 'CIFRegistry'):
        super().__init__()
        self.analyzer = analyzer
        self._cif     = cif
        self.transforms = nn.ModuleList([
            nn.Sequential(nn.Linear(d_model, d_model), nn.LayerNorm(d_model),
                          nn.GELU(), nn.Linear(d_model, d_model))
            for _ in range(10)])
        self.lvl_attn = nn.MultiheadAttention(d_model, 4, batch_first=True)
        self.fuse = nn.Sequential(nn.Linear(d_model*2, d_model), nn.LayerNorm(d_model))
        # CIF: spine positions list is static — Deny rebuilding it per forward
        self._spine_list_cif = Deny(analyzer.spine)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        B, S, D = x.shape
        updates = {}
        # CIF: spine list is static — same list every forward call
        spine = self.analyzer.spine   # already pre-built, no recompute
        for pos in spine:
            if pos < 3 or pos >= S: continue
            st = self.analyzer.get(pos)   # CIF inside SpineAnalyzer
            lvl_feats = []
            for lv in range(1, st["max_depth"]+1):
                if lv not in st["levels"]: continue
                nodes = [n for n in st["levels"][lv] if n < S]
                if not nodes: continue
                wts   = [st["path_counts"].get(n, 1) for n in nodes]
                total = sum(wts) or 1
                feat  = sum(x[:, n, :] * w for n, w in zip(nodes, wts)) / total
                lvl_feats.append(self.transforms[lv](feat))
            if not lvl_feats: continue
            stk = torch.stack(lvl_feats, dim=1)
            att, _ = self.lvl_attn(x[:, pos:pos+1, :], stk, stk)
            updates[pos] = self.fuse(torch.cat([att.squeeze(1), x[:, pos, :]], dim=-1))

        if not updates: return x
        slices, last = [], 0
        for p in sorted(updates):
            if p > last: slices.append(x[:, last:p, :])
            slices.append(updates[p].unsqueeze(1)); last = p+1
        if last < S: slices.append(x[:, last:, :])
        return torch.cat(slices, dim=1)


class PathWeightedLatticeCore(nn.Module):
    def __init__(self, d_model: int, analyzer: SpineAnalyzer, cif: 'CIFRegistry'):
        super().__init__()
        self.analyzer = analyzer
        self._cif     = cif
        self.pw_net   = nn.Sequential(nn.Linear(1,64), nn.ReLU(),
                                      nn.Linear(64,1), nn.Softplus())
        self.msg_fn   = nn.Sequential(nn.Linear(d_model*2, d_model),
                                      nn.LayerNorm(d_model), nn.GELU())
        self.agg      = nn.GRU(d_model, d_model, batch_first=True)
        self.gate_fn  = nn.Sequential(nn.Linear(d_model*2, d_model), nn.Sigmoid())

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        B, S, D = x.shape
        updates = {}
        for pos in self.analyzer.spine:
            if pos < 3 or pos >= S: continue
            st = self.analyzer.get(pos)
            if st["total_ancestors"] == 0: continue
            ancs, pcs = [], []
            for lv, nodes in st["levels"].items():
                if lv == 0: continue
                for n in nodes:
                    if n < S: ancs.append(n); pcs.append(st["path_counts"].get(n, 1))
            if not ancs: continue
            pc_t = torch.tensor(pcs, device=x.device).float().unsqueeze(-1)
            pw   = self.pw_net(pc_t).squeeze(-1)
            msgs = torch.stack([
                self.msg_fn(torch.cat([x[:,a,:], x[:,pos,:]], dim=-1))
                for a in ancs], dim=1)
            if pw.dim() == 0: pw = pw.unsqueeze(0)
            agg, _ = self.agg(msgs * pw.view(1,-1,1))
            agg    = agg[:, -1, :]
            gate   = self.gate_fn(torch.cat([agg, x[:,pos,:]], dim=-1))
            updates[pos] = gate * agg + (1-gate) * x[:,pos,:]

        if not updates: return x
        slices, last = [], 0
        for p in sorted(updates):
            if p > last: slices.append(x[:, last:p, :])
            slices.append(updates[p].unsqueeze(1)); last = p+1
        if last < S: slices.append(x[:, last:, :])
        return torch.cat(slices, dim=1)


class CompleteLatticeCore(nn.Module):
    def __init__(self, d_model: int, analyzer: SpineAnalyzer, cif: 'CIFRegistry'):
        super().__init__()
        self.ml   = MultiLevelLatticeProcessor(d_model, analyzer, cif)
        self.pw   = PathWeightedLatticeCore(d_model, analyzer, cif)
        # CIF: fusion input size is d_model*3 — static
        fuse_in   = cif.lattice_cat.get()
        self.fuse = nn.Sequential(
            nn.Linear(fuse_in, d_model*2), nn.LayerNorm(d_model*2),
            nn.GELU(), nn.Linear(d_model*2, d_model))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.fuse(torch.cat([x, self.ml(x), self.pw(x)], dim=-1))


# ══════════════════════════════════════════════════════════════════════
# 10.  UNCERTAINTY-AWARE HORIZON PREDICTOR
# ══════════════════════════════════════════════════════════════════════

class UncertaintyAwareHorizon(nn.Module):
    def __init__(self, d_model: int, vocab_size: int,
                 max_horizon: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif  = cif
        self.max_h = max_horizon
        self.unc   = nn.Sequential(nn.Linear(d_model, d_model//4), nn.GELU(),
                                   nn.Linear(d_model//4, 1), nn.Sigmoid())
        self.near  = nn.Linear(d_model, vocab_size * 4)
        self.mid   = nn.Linear(d_model, vocab_size * 16)
        self.far   = nn.Linear(d_model, vocab_size * 44)

    def forward(self, h: torch.Tensor):
        B  = h.size(0)
        ht = h[:, -1, :]
        unc = self.unc(ht)
        horizon = (self.max_h * (1-unc)).long().clamp(4, self.max_h).squeeze(-1)
        near = self.near(ht).view(B,  4, -1)
        mid  = self.mid(ht).view(B, 16, -1)
        far  = self.far(ht).view(B, 44, -1)
        return torch.cat([near, mid, far], dim=1), horizon, unc


# ══════════════════════════════════════════════════════════════════════
# 11.  ADAPTIVE BLOCK w/ EARLY EXIT
# ══════════════════════════════════════════════════════════════════════

class TransformerLayer(nn.Module):
    def __init__(self, d_model: int, n_heads: int, cif: 'CIFRegistry', dropout: float = 0.1):
        super().__init__()
        self.attn  = FlashBlockSparseAttention(d_model, n_heads, cif, dropout)
        self.mixer = DiamondMixer(d_model, cif)
        self.norm  = nn.LayerNorm(d_model)
        self.drop  = nn.Dropout(dropout)

    def forward(self, x, layer_past=None):
        a, present = self.attn(self.norm(x), layer_past)
        x = x + self.drop(a)
        x = self.mixer(x)
        return x, present


class AdaptiveBlock(nn.Module):
    def __init__(self, d_model: int, n_heads: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif  = cif
        self.layer = TransformerLayer(d_model, n_heads, cif)
        self.conf  = nn.Sequential(
            nn.AdaptiveAvgPool1d(1), nn.Flatten(),
            nn.Linear(d_model, 1), nn.Sigmoid())
        # CIF: exit threshold is static — Deny it
        # The comparison `conf > threshold` becomes a monomorphic branch
        self._thresh_deny = Deny(cif.exit_thresh.get())

    def forward(self, x, layer_past=None):
        out, present = self.layer(x, layer_past)
        conf = self.conf(out.transpose(1,2)).mean() if out.size(1) > 1 \
               else out.new_tensor(0.0)
        # CIF: threshold is static (Deny), confidence is dynamic (Affirm)
        # This makes the branch monomorphic on the threshold side
        thresh = self._cif.exit_thresh.get()   # O(1)
        return out, conf, present, conf.item() > thresh


