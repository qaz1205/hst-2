# 7.  FEEDBACK LOOP
# ══════════════════════════════════════════════════════════════════════

class FeedbackLoop(nn.Module):
    def __init__(self, d_model: int, cif: 'CIFRegistry'):
        super().__init__()
        self._cif  = cif
        self.cell  = nn.GRUCell(d_model, d_model)
        self.error = nn.Linear(d_model, 1)
        # CIF: iteration count is static — Deny it
        # The loop `for _ in range(iters)` becomes monomorphic
        self._iters_cif = Deny(cif.fb_iters.get())

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        B, S, D = x.shape
        h = x.reshape(-1, D)
        iters = self._cif.fb_iters.get()   # CIF: O(1)
        for _ in range(iters):             # monomorphic loop — CPU predicts perfectly
            err = torch.sigmoid(self.error(h))
            h   = (1 - err) * h + err * self.cell(h, h)
        return h.view(B, S, D)


